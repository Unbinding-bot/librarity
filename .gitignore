# ── Dependencies ─────────────────────────────────────────────────
node_modules/

# ── Environment / Secrets ────────────────────────────────────────
.env
.env.local
.env.development
.env.production
config/secrets.js
secrets.json

# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build outputs ────────────────────────────────────────────────
dist/
build/
*.min.js
*.min.css

# ── Temp ─────────────────────────────────────────────────────────
tmp/
temp/
*.tmp

# ── Word lists (large source files — generated JSONs in data/ are committed) ──
word-lists/

# ── Large user-uploaded assets ───────────────────────────────────
assets/images/banners/*.jpg
assets/images/banners/*.png
assets/images/books/*.jpg
assets/images/books/*.png
assets/images/coming-soon/*.jpg
assets/images/coming-soon/*.png

# ── Keep empty asset directories ─────────────────────────────────
!assets/images/banners/.gitkeep
!assets/images/books/.gitkeep
!assets/images/coming-soon/.gitkeep
!assets/images/cursors/.gitkeep
!assets/sounds/.gitkeep

# ── Python cache ─────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Kiro (AI IDE internal files — not needed in repo) ────────────
.kiro/
