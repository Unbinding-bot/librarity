{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/library/events/:id", "destination": "/library/events/:id/index.html" },
    { "source": "/library/(.*)", "destination": "/library/index.html" }
  ]
}
