{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && node scripts/prerender.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/library/events/:id", "destination": "/library/events/:id/index.html" },
    { "source": "/library/:path*", "destination": "/library/index.html" }
  ],
  "redirects": [
    { "source": "/", "destination": "/library/", "permanent": false }
  ]
}
