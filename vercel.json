{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/prerender.mjs",
  "rewrites": [
    {
      "source": "/library/events/:id",
      "destination": "/library/events/:id/index.html"
    },
    {
      "source": "/library/assets/(.*)",
      "destination": "/library/assets/$1"
    },
    {
      "source": "/library/(.*\\.css|.*\\.js|.*\\.png|.*\\.jpg|.*\\.svg|.*\\.woff2?|.*\\.ico)",
      "destination": "/library/$1"
    },
    {
      "source": "/library/:path*",
      "destination": "/library/index.html"
    }
  ]
}
